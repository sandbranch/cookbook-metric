{"@context": "http://schema.org", "@type": "Recipe", "id": "1", "name": "Okonomiyaki", "description": "A savory Japanese pancake.", "url": "https://example.org/okonomiyaki", "dateCreated": "2025-05-19T07:23:00+00:00", "dateModified": "2025-05-19T07:23:00+00:00", "recipeYield": 3, "recipeIngredient": ["400 grams cabbage ((~half a small head))", "60 grams scallions ((~2 , thinly sliced))", "140 grams all-purpose flour ((~1 cup))", "2 large eggs", "1/2 cup dashi stock ((or cold water))", "9 slices bacon", "okonomiyaki sauce"], "recipeInstructions": ["Combine the cabbage, scallions and flour.", "Bake at 400°F until crisp."], "tool": ["baking sheet", "9-inch skillet"]}
